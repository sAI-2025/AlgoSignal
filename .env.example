# Django settings
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database and cache
DATABASE_URL=sqlite:///db.sqlite3
CACHE_URL=locmemcache://

# Regional settings
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# AlgoSignal data settings
INDEX_UNIVERSE=NIFTY100
MARKET_DATA_PROVIDER=yfinance
PROVIDER_THROTTLE_SECONDS=2.0
NIFTY_INDEX_CSV_URLS={"NIFTY100":["https://niftyindices.com/IndexConstituent/ind_nifty100list.csv","https://archives.nseindia.com/content/indices/ind_nifty100list.csv"]}
NIFTY_IMPORT_USER_AGENT=AlgoSignal/1.0 (constituent-import; contact: local-dev)

# Provider reliability policy (fetcher)
PROVIDER_MAX_RETRIES=3
PROVIDER_CIRCUIT_THRESHOLD=5
PROVIDER_COOLDOWN_SECONDS=1800
FETCH_HEARTBEAT_TIMEOUT_MIN=15

# Optional Kite integration (leave empty for now)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Optional holiday calendar
NSE_HOLIDAYS_FILE=

# Logging
LOG_LEVEL=INFO
